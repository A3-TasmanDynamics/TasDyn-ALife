// TasDyn-ALife -- mission config.
//
// Join flow: pick a slot (Police = BLUFOR, Medic = Independent, Civilian)
// -> the server loads your character from the database -> you pick a
// spawn point -> you're in. See README.md.

author = "Tasman Dynamics";
onLoadName = "TasDyn-ALife";
onLoadMission = "Altis Life roleplay";

class Header
{
    gameType = "RPG";
    minPlayers = 1;
    maxPlayers = 48; // must match the slots in mission.sqm
};

// Respawn at base, but never at mission start: every player goes through
// the spawn menu instead (onPlayerRespawn.sqf opens it again after death).
// The death screen holds respawn until you press its Respawn button
// (CfgALife >> respawnTime); respawnDelay is only the fallback.
respawn = 3;
respawnDelay = 10;
respawnOnStart = -1;
respawnDialog = 0;
respawnButton = 1;
respawnTemplates[] = {};

// Unused slots stay empty instead of being filled with AI.
disabledAI = 1;
joinUnassigned = 0;

enableDebugConsole = 1;      // logged-in admins only
allowFunctionsRecompile = 0;
saving = 0;

corpseManagerMode = 1;
corpseLimit = 20;
corpseRemovalMinTime = 300;
corpseRemovalMaxTime = 900;

#include "config\CfgFunctions.hpp"
#include "config\CfgRemoteExec.hpp"
#include "config\CfgSpawnPoints.hpp"
#include "config\CfgALife.hpp"
#include "config\CfgItems.hpp"
#include "config\CfgShops.hpp"
#include "config\CfgLicences.hpp"
#include "config\CfgPhone.hpp"
#include "ui\base.hpp"
#include "ui\spawnMenu.hpp"
#include "ui\deathScreen.hpp"
#include "ui\phone.hpp"
#include "ui\shop.hpp"
#include "ui\transfer.hpp"
#include "ui\atm.hpp"

class RscTitles
{
#include "ui\loading.hpp"
#include "ui\progress.hpp"
};
