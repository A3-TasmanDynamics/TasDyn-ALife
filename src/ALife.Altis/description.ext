// TasDyn-ALife — mission description.
//
// Deliberately minimal right now: just what Phase 1 (the C++/DB bridge)
// needs to be reachable from SQF. Gameplay-facing settings (respawn type,
// briefing, loadouts, ...) are Phase 2 territory and intentionally not
// guessed at here — add them when that design actually exists, not before.

#include "CfgFunctions.hpp"
#include "CfgRemoteExec.hpp"
#include "config\spawn_config.hpp"
#include "dialog\spawnMenu.hpp"

author = "Tasman Dynamics";
onLoadName = "TasDyn-ALife";

// Without this, the engine logs "Missing 'description.ext::Header'" and
// won't list the mission's game-type/player-count metadata (server browser,
// mission-select). Not the roleplay-specific gameplay config (that's Phase
// 2 territory) -- just the required minimum the engine expects to exist.
class Header
{
	gameType = "RPG";
	minPlayers = 1;
	maxPlayers = 64;
};
