// TasDyn-ALife -- mission config.
//
// Join flow: pick a slot (Police = BLUFOR, Medic = Independent, Civilian)
// -> the server loads your character from the database -> you pick a
// spawn point -> you're in. See README.md.

author = "Tasman Dynamics";
onLoadName = "ALife";
onLoadMission = "Altis Life on Arma 3, built properly.";
// The brand's loading picture: the brush A on navy (tools/branding/make_brush_a.py).
loadScreen = "ui\brand\alife_load_co.paa";
overviewPicture = "ui\brand\alife_load_co.paa";
overviewText = "Altis Life on Arma 3, built properly. By Tasman Dynamics.";

class Header
{
    gameType = "RPG";
    minPlayers = 1;
    maxPlayers = 48; // must match the slots in mission.sqm
};

// Respawn at base, but never at mission start: every player goes through
// the spawn menu instead (onPlayerRespawn.sqf opens it again after death).
// The death screen holds respawn until you press its Respawn button
// (CfgALife >> respawnTime); respawnDelay is only the fallback.
// The vehicle shop's 3D preview is a local-only vehicle (createVehicleLocal),
// which multiplayer allows only with this on. It only lets a client create
// objects that exist on its own machine.
unsafeCVL = 1;

respawn = 3;
respawnDelay = 10;
respawnOnStart = -1;
respawnDialog = 0;
respawnButton = 1;
respawnTemplates[] = {};

// Unused slots stay empty instead of being filled with AI.
disabledAI = 1;
joinUnassigned = 1;          // players pick their own slot in the lobby (no auto-assign)

enableDebugConsole = 1;      // logged-in admins only
allowFunctionsRecompile = 0;
saving = 0;

corpseManagerMode = 1;
corpseLimit = 20;
corpseRemovalMinTime = 300;
corpseRemovalMaxTime = 900;

