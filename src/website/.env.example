# Copy to .env (git-ignored) and fill in real values for local development.
# In production these are real environment variables (systemd/Docker/etc),
# not a file read at startup -- see internal/config/config.go.

DATABASE_URL=postgres://alife_admin:alife_admin@127.0.0.1:5432/alife_db
LISTEN_ADDR=:8080
SITE_BASE_URL=http://localhost:8080

# Set to "true" only once served over real HTTPS -- a Secure cookie is
# silently refused by the browser over plain http://, which is exactly why
# local dev defaults to false. See docs/WEBSITE.md §10.
COOKIE_SECURE=false

# One Discord Application (discord.com/developers/applications) provides
# BOTH credential pairs below, for two unrelated purposes -- see
# internal/config/config.go's comment on DiscordOAuthClientID.

# OAuth2 tab: "Sign in / Connect with Discord". Redirect URL registered
# there must exactly match SITE_BASE_URL + /auth/discord/callback.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# Bot tab: the two-way `/link` command (and later, ticket-thread sync).
# Leave empty to run the site with Discord OAuth login/connect only, no bot.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TICKET_CATEGORY_ID=

# Webhook URLs (Server Settings -> Integrations -> Webhooks in Discord),
# one per log category. Leave any empty to simply not post that category.
DISCORD_STAFF_LOG_WEBHOOK=
DISCORD_TICKET_LOG_WEBHOOK=
DISCORD_ANTICHEAT_WEBHOOK=

# Arma 3 server's Steam query endpoint (query port = game port + 1, so 2303 by
# default) -- the public /status page queries it for a real up/down signal.
# Leave empty and the game server shows as "not monitored" instead.
GAME_QUERY_ADDR=

# Steam Web API key (https://steamcommunity.com/dev/apikey) -- caches Steam names,
# avatars, account age and VAC/game-ban status for the panels. Optional.
STEAM_WEB_API_KEY=

# Admin → Database: a SELECT-only role for the database browser. Optional;
# without it, queries run in read-only transactions on DATABASE_URL.
# Create the role with database/fixes/2026-09-30_readonly_role.sql.
DATABASE_READONLY_URL=

# Admin → Server Control: server_manager's control API on the game host.
# Copy ControlAPIToken from server_manager's settings.json. Optional; the
# page explains how to connect it when these are blank.
SERVER_MANAGER_URL=http://127.0.0.1:8095
SERVER_MANAGER_TOKEN=
