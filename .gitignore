# --- Secrets / local config ---
# NEVER commit real database credentials
config.ini
database.ini
.env
*.env

# --- Arma 3 build artifacts ---
*.pbo
*.bisign
*.bikey

# --- C++ build output ---
build/
out/
x64/
Debug/
Release/
*.dll
*.pdb
*.lib
*.exp
*.obj

# --- Visual Studio ---
.vs/
*.suo
*.user
*.ncb
*.aps

# --- Wails (src/server_manager) ---
# Its build/ folder mixes legitimate source (app icon, platform manifests,
# the NSIS installer script) with generated output (build/bin/) in the same
# directory, unlike the C++ build/ convention above -- a parent directory
# match blocks git from seeing anything inside it regardless of later
# patterns, so the directory itself has to be un-ignored first.
!src/server_manager/build/
!src/server_manager/build/**
src/server_manager/build/bin/

# --- Local server deploy target (never source of truth) ---
server_dist/
Profiles/
*.log
*.rpt

# --- Backups ---
*.bak
*.backup

# --- OS ---
.DS_Store
Thumbs.db

