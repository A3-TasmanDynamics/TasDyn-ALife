; Copy this file to config.ini (next to the compiled extension DLL) and fill in
; real values. config.ini is git-ignored — never commit it.
[database]
host=127.0.0.1
port=5432
dbname=alife_db
user=alife_admin
password=CHANGE_ME

; [server] is written by the Server Manager when it deploys the extension:
; command_password = the server's serverCommandPassword (its admin password),
; used by the mission to really kick players. Don't put it here by hand.
